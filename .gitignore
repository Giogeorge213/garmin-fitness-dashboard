# ============================================================================
# Personal data: NEVER commit real health / activity / GPS data.
# The live dashboard reads these from S3; git carries only code.
# ============================================================================

# Raw + curated pipeline data (wellness JSON, activity CSVs, curated CSVs)
pipeline/out/
data/

# Generated site: render.py INLINES personal data into index.html/data.json,
# and routes.json contains GPS traces. All generated -> not tracked.
site/

